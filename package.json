{
  "name": "blog",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type": "tsc --noEmit",
    "lint": "eslint . --max-warnings 10 --cache --cache-strategy content",
    "inspect": "pnpm type && pnpm lint",
    "clean:caches": "rm -rf .next",
    "clean:modules": "rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "audit": "pnpm audit --audit-level=high",
    "deps:check": "pnpm -r outdated",
    "deps:update": "pnpm -r update && pnpm build",
    "deps:update:major": "pnpm -r up -iL",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "js-cookie": "^3.0.8",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.11",
    "pretendard": "^1.3.9",
    "query-string": "^9.4.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.14.0",
    "tiny-invariant": "^1.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write",
    "*.{md,json}": "prettier --write"
  }
}
